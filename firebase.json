{
  "hosting": [
    {
      "site": "dunvantclub",
      "public": ".",
      "cleanUrls": true,
      "trailingSlash": false,
      "rewrites": [
        {
          "source": "/",
          "destination": "/club-website.html"
        }
      ],
      "ignore": [
        "firebase.json",
        ".firebaserc",
        "**/.*",
        "**/node_modules/**",
        "docs/**",
        "README.md",
        "functions/**",
        "firestore.rules"
      ],
      "headers": [
        {
          "regex": "^/[^.]*$",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/*.@(html|js|css|json)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=604800"
            }
          ]
        },
        {
          "source": "version.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store"
            }
          ]
        }
      ]
    },
    {
      "site": "dunvant-staff",
      "public": ".",
      "cleanUrls": true,
      "trailingSlash": false,
      "rewrites": [
        {
          "source": "/",
          "destination": "/staff-area.html"
        }
      ],
      "ignore": [
        "firebase.json",
        ".firebaserc",
        "**/.*",
        "**/node_modules/**",
        "docs/**",
        "README.md",
        "index.html",
        "functions/**",
        "firestore.rules"
      ],
      "headers": [
        {
          "regex": "^/[^.]*$",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/*.@(html|js|css|json)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=604800"
            }
          ]
        },
        {
          "source": "version.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store"
            }
          ]
        }
      ]
    }
  ],
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ]
}

{
  "hosting": [
    {
      "site": "dunvantclub",
      "public": ".",
      "cleanUrls": true,
      "trailingSlash": false,
      "rewrites": [
        {
          "source": "/",
          "destination": "/club-website.html"
        }
      ],
      "ignore": [
        "firebase.json",
        ".firebaserc",
        "**/.*",
        "**/node_modules/**",
        "docs/**",
        "README.md"
      ],
      "headers": [
        {
          "source": "**/*.@(html)",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache" }
          ]
        },
        {
          "source": "assets/**",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=604800" }
          ]
        }
      ]
    },
    {
      "site": "dunvant-staff",
      "public": ".",
      "cleanUrls": true,
      "trailingSlash": false,
      "rewrites": [
        {
          "source": "/",
          "destination": "/staff-area.html"
        }
      ],
      "ignore": [
        "firebase.json",
        ".firebaserc",
        "**/.*",
        "**/node_modules/**",
        "docs/**",
        "README.md"
      ],
      "headers": [
        {
          "source": "**/*.@(html)",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache" }
          ]
        },
        {
          "source": "assets/**",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=604800" }
          ]
        }
      ]
    }
  ]
}
